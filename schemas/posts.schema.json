{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Posts",
  "type": "object",
  "required": ["posts"],
  "properties": {
    "posts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "date", "location_id", "gear_id", "outfit", "ai_label"],
        "properties": {
          "id": { "type": "string", "pattern": "^post_" },
          "status": { "type": "string", "enum": ["draft", "ready", "published", "archived"] },
          "platform": { "type": "string", "enum": ["instagram", "tiktok", "x", "threads", "youtube"] },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "time": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
          "location_id": { "type": "string", "pattern": "^loc_" },
          "gear_id": { "type": "string", "pattern": "^gear_" },
          "outfit": { "type": "array", "items": { "type": "string", "pattern": "^itm_" } },
          "exif": {
            "type": "object",
            "properties": {
              "focal_length_mm": { "type": "number" },
              "aperture": { "type": "string" },
              "iso": { "type": "integer" },
              "aspect": { "type": "string" }
            }
          },
          "caption": { "type": "string" },
          "ai_label": { "type": "boolean", "description": "AI生成である旨の表示。false で published にはできない。" },
          "pr": { "type": "boolean", "description": "広告・タイアップか。true なら caption に #PR 等の明示が必要。" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
