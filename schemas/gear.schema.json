{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gear",
  "type": "object",
  "required": ["devices"],
  "properties": {
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "brand", "model", "lenses", "aspect_ratios", "verified"],
        "properties": {
          "id": { "type": "string", "pattern": "^gear_" },
          "role": { "type": "string", "enum": ["primary", "secondary"] },
          "kind": { "type": "string", "enum": ["smartphone", "mirrorless", "dslr", "film_camera", "compact"] },
          "brand": { "type": "string" },
          "model": { "type": "string" },
          "acquired_date": { "type": ["string", "null"] },
          "release_date": { "type": ["string", "null"] },
          "verified": { "type": "boolean" },
          "source": { "type": ["string", "null"] },
          "lenses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["focal_length_mm"],
              "properties": {
                "name": { "type": "string" },
                "focal_length_mm": { "type": "number" },
                "aperture": { "type": "string" },
                "sensor": { "type": "string" }
              }
            }
          },
          "aspect_ratios": { "type": "array", "items": { "type": "string" } },
          "default_aspect": { "type": "string" },
          "iso_range": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
          "notes": { "type": "string" }
        }
      }
    },
    "shooting_defaults": { "type": "object" }
  }
}
